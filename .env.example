# Required
DISCORD_TOKEN=
DATABASE_URL=postgres://lapbot:lapbot@localhost:5432/lapbot

# Needed by `pnpm commands:register`. With DISCORD_GUILD_ID set, commands are
# registered to that server only and update instantly.
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

LOG_LEVEL=info
DEFAULT_TIMEZONE=Europe/Tallinn

# Legacy reaction role panel. Leave ROLE_SELECTION_CHANNEL_ID empty to disable.
ROLE_SELECTION_CHANNEL_ID=
TARKVARA_ROLE_ID=
HELPDESK_ROLE_ID=
KULTUUR_ROLE_ID=

# Redmine channel notifications (optional). Setting REDMINE_BASE_URL enables
# them and requires REDMINE_API_KEY, a restricted service account.
REDMINE_BASE_URL=
REDMINE_API_KEY=

# Web UI. Off unless WEB_PORT is set; needs DISCORD_GUILD_ID and Discord
# sign-in: DISCORD_CLIENT_SECRET from the developer portal (OAuth2), with
# <WEB_URL>/login added there as a redirect.
WEB_PORT=
WEB_HOST=127.0.0.1
WEB_URL=
DISCORD_CLIENT_SECRET=
# openssl rand -hex 32; keeps people signed in across restarts.
SESSION_SECRET=

# Used by compose.yaml for the bundled PostgreSQL.
POSTGRES_PASSWORD=
