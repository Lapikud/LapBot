# Required
DISCORD_TOKEN=
DATABASE_URL=postgres://lapbot:lapbot@localhost:5432/lapbot

# Commands register at startup. With DISCORD_GUILD_ID set, commands are
# registered to that server only and update instantly.
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

LOG_LEVEL=info
LOG_DATABASE_PATH=logs/lapbot.sqlite
DEFAULT_TIMEZONE=Europe/Tallinn

# Movie details (optional). A TMDB "API Read Access Token" from
# https://www.themoviedb.org/settings/api fills in trailers, posters and synopses.
TMDB_ACCESS_TOKEN=

# Club Google Calendar (optional): lapikud@gmail.com, and the service
# account's JSON key on one line. Share the calendar with the service
# account's email with "Make changes to events".
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Web UI. Off unless WEB_PORT is set; needs DISCORD_GUILD_ID and Discord
# sign-in: DISCORD_CLIENT_SECRET from the developer portal (OAuth2), with
# <WEB_URL>/login added there as a redirect.
WEB_PORT=
WEB_HOST=127.0.0.1
WEB_URL=
DISCORD_CLIENT_SECRET=
# openssl rand -hex 32; keeps people signed in across restarts.
SESSION_SECRET=

# Juhatus role members are application administrators (all bot permissions).
JUHATUS_ROLE_ID=
