# Required
DISCORD_TOKEN=
DATABASE_URL=postgres://lapbot:lapbot@localhost:5432/lapbot

# Needed by `pnpm commands:register`. With DISCORD_GUILD_ID set, commands are
# registered to that server only and update instantly.
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

LOG_LEVEL=info
DEFAULT_TIMEZONE=Europe/Tallinn

# Legacy reaction role panel. Leave ROLE_SELECTION_CHANNEL_ID empty to disable.
ROLE_SELECTION_CHANNEL_ID=
TARKVARA_ROLE_ID=
HELPDESK_ROLE_ID=
KULTUUR_ROLE_ID=

# Redmine (optional). Setting REDMINE_BASE_URL enables the feature and then
# requires CREDENTIAL_ENCRYPTION_KEY. REDMINE_API_KEY is a restricted service
# account used only for channel notifications.
# Generate a key with: openssl rand -base64 32
REDMINE_BASE_URL=
REDMINE_API_KEY=
CREDENTIAL_ENCRYPTION_KEY=

# Web UI (PSAs, events, polls, permissions, settings). Off unless WEB_PORT is
# set; requires DISCORD_GUILD_ID. There is no sign-in yet: anyone who can reach
# the port acts as an administrator, so keep it on localhost.
WEB_PORT=
WEB_HOST=127.0.0.1

# Used by compose.yaml for the bundled PostgreSQL.
POSTGRES_PASSWORD=
