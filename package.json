{
  "name": "lapbot",
  "version": "2.0.0",
  "private": true,
  "description": "Lapikud community Discord bot",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:db": "docker compose -f compose.test.yaml up -d --wait",
    "test:integration": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@googleapis/calendar": "^20.2.0",
    "@hono/node-server": "^2.1.8",
    "@hono/oauth-providers": "^0.9.1",
    "better-sqlite3": "^13.2.0",
    "chrono-node": "^2.10.3",
    "date-fns": "^4.4.0",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "tmdb-ts": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
